-- Template: Medida HTML para Power BI
-- Substitua os valores e conteúdo conforme necessário
-- Use via: python pbi_apply.py "<Nome>" arquivo.dax validate <PORTA>

VAR titulo = "Título da Tabela"
VAR dados = SELECTCOLUMNS(
    'Sua Tabela',
    "Coluna1", [Campo1],
    "Coluna2", [Campo2]
)

VAR cabecalho = "<tr><th>Coluna1</th><th>Coluna2</th></tr>"

VAR linhas = CONCATENATEX(
    TOPN(20, dados, [Coluna1], ASC),
    "<tr><td>" & [Coluna1] & "</td><td>" & [Coluna2] & "</td></tr>",
    ""
)

RETURN "
<style>
body { font-family: 'Segoe UI', Arial, sans-serif; background: #F3F6FA; color: #061B43; margin: 0; padding: 8px; }
.hdr { background: linear-gradient(90deg, #00183D, #06275A 45%, #0B4FA3); color: #fff; border-radius: 10px; padding: 12px 18px; margin-bottom: 12px; }
.hdr h1 { margin: 0; font-size: 16px; font-weight: 800; text-transform: uppercase; }
table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden; }
thead th { background: #06275A; color: #fff; font-size: 10px; font-weight: 700; padding: 6px 8px; text-align: center; }
tbody td { padding: 4px 8px; border-bottom: 1px solid #E6EAF1; text-align: center; font-weight: 600; font-size: 11px; }
</style>
<div class='hdr'><h1>" & titulo & "</h1></div>
<table>
  <thead>" & cabecalho & "</thead>
  <tbody>" & linhas & "</tbody>
</table>
"